        // Quiz & Game Adventure Mechanics
        function setupQuizQuestions() {
            let qList = [];
            stagesData.forEach(s => {
                s.words.forEach(w => {
                    qList.push({
                        category: s.title,
                        jp: w.word,
                        kana: w.kana,
                        romaji: getAccurateRomaji(w.kana),
                        correct: w.meaning,
                        options: shuffleArray([w.meaning, '感謝', '水', '好吃', '再見', '多少錢', '車站']).slice(0, 4)
                    });
                });
            });
            state.quizState.questions = shuffleArray(qList);
        }

        function startQuizGame() {
            state.quizState.score = 0;
            state.quizState.combo = 0;
            state.quizState.lives = 3;
            state.quizState.currentIdx = 0;

            document.getElementById('quiz-container').classList.remove('hidden');
            document.getElementById('game-over-box').classList.add('hidden');
            updateGameUI();
            loadNextQuizQuestion();
        }

        function loadNextQuizQuestion() {
            const q = state.quizState.questions[state.quizState.currentIdx];
            if (!q || state.quizState.lives <= 0) {
                endQuizGame();
                return;
            }

            document.getElementById('quiz-category').innerText = q.category;
            document.getElementById('quiz-question-jp').innerText = q.jp;
            document.getElementById('quiz-question-kana').innerText = `${q.kana} (${q.romaji})`;

            // Generate option buttons
            if (!q.options.includes(q.correct)) {
                q.options[0] = q.correct;
                q.options = shuffleArray(q.options);
            }

            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = q.options.map(opt => `
                <button onclick="submitQuizAnswer('${opt}')" class="bg-sakura-50 hover:bg-sakura-100 border-2 border-sakura-200 text-gray-800 font-bold py-3.5 px-4 rounded-2xl text-xs sm:text-sm transition touch-bounce shadow-sm">
                    ${opt}
                </button>
            `).join('');

            playAudioText(q.jp);
        }

        function submitQuizAnswer(selected) {
            const q = state.quizState.questions[state.quizState.currentIdx];
            if (selected === q.correct) {
                // Correct Answer
                playBeepSound(600, 0.1);
                state.quizState.score += 20 + (state.quizState.combo * 5);
                state.quizState.combo += 1;
                addXP(10);
            } else {
                // Wrong Answer
                playBeepSound(200, 0.2);
                state.quizState.lives -= 1;
                state.quizState.combo = 0;
            }

            state.quizState.currentIdx += 1;
            updateGameUI();

            if (state.quizState.lives <= 0 || state.quizState.currentIdx >= state.quizState.questions.length) {
                endQuizGame();
            } else {
                loadNextQuizQuestion();
            }
        }

        function updateGameUI() {
            document.getElementById('game-score').innerText = state.quizState.score;
            document.getElementById('game-combo').innerText = state.quizState.combo;

            let heartsHtml = '';
            for (let i = 0; i < 3; i++) {
                if (i < state.quizState.lives) {
                    heartsHtml += '<i class="fa-solid fa-heart text-red-500"></i>';
                } else {
                    heartsHtml += '<i class="fa-regular fa-heart text-gray-300"></i>';
                }
            }
            document.getElementById('game-lives').innerHTML = heartsHtml;
        }

        function endQuizGame() {
            document.getElementById('quiz-container').classList.add('hidden');
            document.getElementById('game-over-box').classList.remove('hidden');
            document.getElementById('final-score').innerText = state.quizState.score;

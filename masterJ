                                <button onclick="playAudioText('${item.jp}', event)" class="w-9 h-9 bg-sakura-500 hover:bg-sakura-600 text-white rounded-xl flex items-center justify-center flex-shrink-0 touch-bounce">
                                    <i class="fa-solid fa-volume-high text-xs"></i>
                                </button>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `).join('');

            // Highlight category buttons
            document.querySelectorAll('.theme-tab-btn').forEach(b => {
                b.className = 'theme-tab-btn bg-gray-100 text-gray-600 px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap';
            });
            if (event && event.target) {
                event.target.className = 'theme-tab-btn bg-sakura-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap';
            }
        }

        // Popup Dictionary & Phonetic Lookup Modal
        function lookupWord(word, kana, romaji, pos, meaning, exJp, exZh) {
            const accurateRomaji = romaji || getAccurateRomaji(kana || word);
            state.currentDictWord = { word, kana: kana || word, romaji: accurateRomaji, pos: pos || '單字', meaning: meaning || '解釋' };

            document.getElementById('dict-word').innerText = word;
            document.getElementById('dict-kana').innerText = kana || word;
            document.getElementById('dict-romaji').innerText = accurateRomaji;
            document.getElementById('dict-pos').innerText = pos || '單字';
            document.getElementById('dict-meaning').innerText = meaning || '點擊朗讀發音';

            document.getElementById('dict-example-jp').innerText = exJp || `${word}を使います。`;
            document.getElementById('dict-example-zh').innerText = exZh || `（使用「${word}」來表達。）`;

            document.getElementById('dict-modal').classList.remove('hidden');
            playAudioText(word);
        }

        function closeDictModal() {
            document.getElementById('dict-modal').classList.add('hidden');
        }

        function playCurrentDictAudio(e) {
            if (e) e.stopPropagation();
            if (state.currentDictWord) {
                playAudioText(state.currentDictWord.word);
            }
        }

        // Single Speech Audio Player (Prevents Duplicate Playback)
        function playAudioText(text, event) {
            if (event) event.stopPropagation(); // Avoid double event trigger
            if (!('speechSynthesis' in window)) return;

            window.speechSynthesis.cancel(); // Cancel any ongoing speech cleanly
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'ja-JP';
            utterance.rate = 0.88;
            window.speechSynthesis.speak(utterance);
        }

        // Saved Words Storage Engine
        function saveCurrentWord() {
            if (!state.currentDictWord) return;
            const exists = state.savedWords.some(w => w.word === state.currentDictWord.word);
            if (!exists) {
                state.savedWords.push(state.currentDictWord);
                localStorage.setItem('saved_jp_words', JSON.stringify(state.savedWords));
                renderSavedWords();
                addXP(15);
                alert(`✨ 已收錄「${state.currentDictWord.word}」至單字筆記！`);
            } else {
                alert(`🌸 「${state.currentDictWord.word}」已經在筆記庫裡囉！`);
            }
            closeDictModal();
        }

        function renderSavedWords() {
            const container = document.getElementById('saved-words-grid');
            if (state.savedWords.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full cute-card rounded-2xl p-6 text-center text-gray-400 space-y-1">
                        <div class="text-3xl">🌸</div>
                        <p class="text-xs font-bold">筆記庫還是空的喔！</p>
                        <p class="text-[10px]">點擊任何文章或例句中的單字即可隨時收藏。</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = state.savedWords.map((item, idx) => `
                <div class="cute-card rounded-2xl p-3.5 bg-white space-y-1.5 relative border-sakura-100">
                    <div class="flex justify-between items-start">
                        <span class="text-[10px] bg-sakura-100 text-sakura-600 font-bold px-2 py-0.5 rounded">${item.pos || '單字'}</span>
                        <button onclick="removeSavedWord(${idx})" class="text-gray-300 hover:text-red-400 text-xs">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                    <div class="flex items-baseline justify-between">
                        <h4 class="text-lg font-extrabold text-gray-800">${item.word}</h4>
                        <span class="text-xs text-sakura-500 font-bold">${item.kana}</span>
                    </div>
                    <p class="text-[11px] text-gray-400 font-semibold">${item.romaji}</p>
                    <p class="text-xs text-gray-700 font-bold">${item.meaning}</p>
                    <button onclick="playAudioText('${item.word}', event)" class="w-full bg-sakura-50 hover:bg-sakura-100 text-sakura-600 font-bold py-1.5 rounded-xl text-xs flex items-center justify-center gap-1 transition">
                        <i class="fa-solid fa-volume-high text-xs"></i> 朗讀發音
                    </button>
                </div>
            `).join('');
        }

        function removeSavedWord(idx) {
            state.savedWords.splice(idx, 1);
            localStorage.setItem('saved_jp_words', JSON.stringify(state.savedWords));
            renderSavedWords();
        }

        function clearSavedWords() {
            if (confirm('確定要清空所有單字筆記嗎？')) {
                state.savedWords = [];
                localStorage.removeItem('saved_jp_words');
                renderSavedWords();
            }
        }

        // Speech Recognition Setup
        function setupSpeechRecognition() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (SpeechRecognition) {
                state.recognition = new SpeechRecognition();
                state.recognition.lang = 'ja-JP';
                state.recognition.onresult = (e) => {
                    const text = e.results[0][0].transcript;
                    document.getElementById('chat-text-input').value = text;
                    sendChatMessage();
                };
                state.recognition.onend = () => {
                    state.isRecording = false;
                    document.getElementById('record-btn').classList.remove('recording-active');
                };
            }
        }

        function toggleVoiceRecording() {
            if (!state.recognition) {
                alert('您的瀏覽器未支援語音辨識，請使用 Chrome 瀏覽器開啓！');
                return;
            }
            if (state.isRecording) {
                state.recognition.stop();
            } else {
                state.isRecording = true;
                document.getElementById('record-btn').classList.add('recording-active');
                state.recognition.start();
            }
        }

        // AI Speaking Chat Logic
        async function sendChatMessage() {
            const input = document.getElementById('chat-text-input');
            const msg = input.value.trim();
            if (!msg) return;

            input.value = '';
            appendChatMessage('user', msg);
            const thinkingId = appendChatMessage('ai', '🍡 糰子老師正在思考中...');

            try {
                let aiText = '';
                if (state.apiKey) {
                    const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${state.apiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{ parts: [{ text: `你是一位活潑親切的日文老師「糰子老師」。學生說了：「${msg}」。請用日文自然回應，附上假名與中文說明。` }] }]
                        })
                    });
                    const data = await res.json();
                    aiText = data.candidates?.[0]?.content?.parts?.[0]?.text || "素晴らしいです！繼續保持練習喔！";
                } else {
                    await new Promise(r => setTimeout(r, 800));
                    aiText = `「${msg}」ですね！上手です！\n（説得真好呢！繼續保持喔！）`;
                }

                document.getElementById(thinkingId).innerText = aiText;
                playAudioText(aiText.split('\n')[0]);
                addXP(10);
            } catch (err) {
                document.getElementById(thinkingId).innerText = "上手ですね！說得很棒！繼續跟我練習吧～";
            }
        }

        function appendChatMessage(role, text) {
            const container = document.getElementById('chat-messages');
            const msgId = 'msg-' + Date.now();
            if (role === 'user') {
                container.innerHTML += `
                    <div class="flex gap-2 justify-end">
                        <div class="bg-sakura-500 text-white rounded-2xl p-3 text-xs max-w-[85%] shadow-xs">
                            <p>${text}</p>
                        </div>
                    </div>
                `;
            } else {
                container.innerHTML += `
                    <div class="flex gap-2.5">
                        <div class="w-8 h-8 rounded-2xl bg-sakura-200 text-sakura-600 flex items-center justify-center text-sm font-black flex-shrink-0">🍡</div>
                        <div class="bg-sakura-50 border border-sakura-200 rounded-2xl p-3 text-gray-800 max-w-[85%] space-y-1">
                            <p id="${msgId}" class="whitespace-pre-line">${text}</p>
                        </div>
                    </div>
                `;
            }
            container.scrollTop = container.scrollHeight;
            return msgId;
        }

        // Helper Utility Functions
        function shuffleArray(arr) {
            return arr.sort(() => Math.random() - 0.5);
        }

        function addXP(amount) {
            state.userXP += amount;
            localStorage.setItem('user_xp', state.userXP);
            updateUserHeaderStats();
        }

        function updateUserHeaderStats() {
            document.getElementById('user-xp').innerText = state.userXP;
            document.getElementById('user-streak').innerText = state.streak;
        }

        function openApiKeyModal() {
            document.getElementById('apikey-modal').classList.remove('hidden');
        }

        function closeApiKeyModal() {
            document.getElementById('apikey-modal').classList.add('hidden');
        }

        function saveApiKey() {
            const val = document.getElementById('api-key-input').value.trim();
            state.apiKey = val;
            localStorage.setItem('gemini_api_key', val);
            closeApiKeyModal();
            alert('API Key 設定完畢！已開啟 AI 智慧對話功能。');
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Jennius要成為日語大師 🌸 Japanese Master</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sakura: {
                            50: '#fff5f7',
                            100: '#ffe3ec',
                            200: '#fcc2d7',
                            300: '#f7a8c4',
                            400: '#f783ac',
                            500: '#e64980',
                            600: '#d6336c',
                        },
                        matcha: {
                            50: '#f4fbf7',
                            100: '#e2f7eb',
                            200: '#c3fae0',
                            400: '#81c784',
                            500: '#51cf66',
                            600: '#40c057',
                        },
                        momi: '#ff922b',
                        dango: '#fcc419'
                    },
                    fontFamily: {
                        sans: ['"M PLUS Rounded 1c"', '"Zen Maru Gothic"', 'Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;500;700;800;900&family=Zen+Maru+Gothic:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }

        body {
            background-color: #fffaf2;
            background-image: radial-gradient(#ffd8e4 0.9px, transparent 0.9px), radial-gradient(#ffd8e4 0.9px, #fffaf2 0.9px);
            background-size: 28px 28px;
            background-position: 0 0, 14px 14px;
            font-family: 'M PLUS Rounded 1c', 'Zen Maru Gothic', sans-serif;
            user-select: text;
            padding-bottom: 80px; /* Space for mobile navigation bar */
        }

        @media (min-width: 768px) {
            body {
                padding-bottom: 20px;
            }
        }

        /* Hide scrollbars for slick app view */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Bouncy touch animation */
        .touch-bounce {
            transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
        }
        .touch-bounce:active {
            transform: scale(0.95);
        }

        /* Clickable interactive Japanese word styling */
        .jp-word {
            cursor: pointer;
            border-bottom: 2px dashed #f783ac;
            transition: all 0.15s ease;
            display: inline-block;
            padding: 0 2px;
            border-radius: 4px;
            font-weight: 700;
        }
        .jp-word:hover, .jp-word:active {
            background-color: #ffe3ec;
            color: #d6336c;
        }

        /* Ruby furigana formatting */
        ruby {
            ruby-position: over;
        }
        rt {
            font-size: 0.62em;
            color: #e64980;
            font-weight: bold;
        }

        /* Cute Card UI */
        .cute-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 2.5px solid #ffe3ec;
            box-shadow: 0 8px 20px rgba(247, 131, 172, 0.1);
        }

        /* Pulse voice recording ring */
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(230, 73, 128, 0.7); }
            70% { transform: scale(1.08); box-shadow: 0 0 0 14px rgba(230, 73, 128, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(230, 73, 128, 0); }
        }
        .recording-active {
            animation: pulse-ring 1.4s infinite;
            background-color: #e64980 !important;
            color: white !important;
        }

        /* Level path connector lines */
        .stage-connector {
            width: 4px;
            height: 32px;
            background: #fcc2d7;
            margin: 0 auto;
            border-radius: 2px;
        }
    </style>
</head>
<body class="text-gray-800 min-h-screen flex flex-col justify-between selection:bg-sakura-200 selection:text-sakura-600">

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b-2 border-sakura-200 shadow-sm">
        <div class="max-w-4xl mx-auto px-4 h-16 sm:h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <div class="flex items-center gap-2.5 cursor-pointer" onclick="switchTab('map')">
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-tr from-sakura-500 to-sakura-400 text-white rounded-2xl flex items-center justify-center text-xl sm:text-2xl shadow-md transform -rotate-3">
                    🍡
                </div>
                <div>
                    <h1 class="font-extrabold text-lg sm:text-2xl text-sakura-600 tracking-wide flex items-center gap-1.5">
                        日語大師
                        <span class="text-[10px] sm:text-xs font-bold bg-matcha-100 text-matcha-600 px-2 py-0.5 rounded-full border border-matcha-200">Gamified SRS</span>
                    </h1>
                    <p class="text-[10px] sm:text-xs text-gray-400 font-medium hidden sm:block">沉浸式情境 · 闖關遊戲 · 智慧語音對話</p>
                </div>
            </div>

            <!-- Top Level & User Stats Badge -->
            <div class="flex items-center gap-2">
                <div class="bg-sakura-50 border border-sakura-200 rounded-2xl px-3 py-1 flex items-center gap-2 shadow-sm">
                    <span class="text-xs sm:text-sm font-black text-sakura-600 flex items-center gap-1">
                        <i class="fa-solid fa-fire text-momi"></i> <span id="user-streak">1</span> 天
                    </span>
                    <span class="text-gray-300">|</span>
                    <span class="text-xs sm:text-sm font-black text-matcha-600 flex items-center gap-1">
                        <i class="fa-solid fa-bolt text-dango"></i> <span id="user-xp">120</span> XP
                    </span>
                </div>

                <button onclick="openApiKeyModal()" class="w-9 h-9 sm:w-10 sm:h-10 bg-sakura-100 hover:bg-sakura-200 text-sakura-600 rounded-2xl flex items-center justify-center text-xs sm:text-sm font-bold transition">
                    <i class="fa-solid fa-gear"></i>
                </button>
            </div>
        </div>

        <!-- Desktop Navigation Bar -->
        <nav class="hidden md:flex justify-center border-t border-sakura-100 py-2 bg-sakura-50/50">
            <div class="flex gap-2">
                <button onclick="switchTab('map')" id="nav-map" class="nav-btn px-4 py-2 rounded-xl font-bold text-xs text-sakura-600 bg-sakura-100 flex items-center gap-2">
                    <i class="fa-solid fa-route"></i> 闖關地圖
                </button>
                <button onclick="switchTab('game')" id="nav-game" class="nav-btn px-4 py-2 rounded-xl font-bold text-xs text-gray-600 hover:bg-sakura-50 flex items-center gap-2">
                    <i class="fa-solid fa-gamepad"></i> 遊戲冒險
                </button>
                <button onclick="switchTab('themes')" id="nav-themes" class="nav-btn px-4 py-2 rounded-xl font-bold text-xs text-gray-600 hover:bg-sakura-50 flex items-center gap-2">
                    <i class="fa-solid fa-layer-group"></i> 多元主題庫
                </button>
                <button onclick="switchTab('speaking')" id="nav-speaking" class="nav-btn px-4 py-2 rounded-xl font-bold text-xs text-gray-600 hover:bg-sakura-50 flex items-center gap-2">
                    <i class="fa-solid fa-comments"></i> AI語音教練
                </button>
                <button onclick="switchTab('notebook')" id="nav-notebook" class="nav-btn px-4 py-2 rounded-xl font-bold text-xs text-gray-600 hover:bg-sakura-50 flex items-center gap-2">
                    <i class="fa-solid fa-bookmark"></i> 單字筆記
                </button>
            </div>
        </nav>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-6 flex-1 w-full">

        <!-- ================= TAB 1: 關卡闖關地圖 (ROADMAP STAGES) ================= -->
        <section id="tab-map" class="tab-content space-y-6">

            <!-- Hero Welcome Card -->
            <div class="cute-card rounded-3xl p-5 sm:p-6 bg-gradient-to-br from-sakura-100 via-white to-matcha-50 relative overflow-hidden">
                <div class="relative z-10 space-y-2">
                    <div class="inline-flex items-center gap-1.5 bg-sakura-500 text-white text-[10px] sm:text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                        <span>🎯 循序漸進關卡模式</span>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-black text-gray-800">歡迎來到日語遊戲學習大本營！</h2>
                    <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                        從五十音、生活點餐、動漫影視到時事新聞，點擊關卡進行情境學習，並至「遊戲冒險」快速驗收！
                    </p>
                </div>
            </div>

            <!-- Stage Map Nodes -->
            <div class="space-y-4 py-2">
                <h3 class="text-lg font-bold text-gray-800 flex items-center justify-between">
                    <span class="flex items-center gap-2"><i class="fa-solid fa-map-location-dot text-sakura-500"></i> 關卡解鎖進度</span>
                    <span class="text-xs text-gray-500 font-normal">共 9 個經典階段</span>
                </h3>

                <div id="roadmap-tree" class="flex flex-col items-center space-y-3">
                    <!-- Dynamically generated stage cards will go here -->
                </div>
            </div>
        </section>

        <!-- ================= TAB 2: 遊戲冒險 (GAMIFIED QUIZ) ================= -->
        <section id="tab-game" class="tab-content hidden space-y-6">
            <div class="cute-card rounded-3xl p-5 sm:p-6 bg-white space-y-5 relative">
                
                <!-- Game Header Status Bar -->
                <div class="flex items-center justify-between border-b border-sakura-100 pb-3">
                    <div class="flex items-center gap-1.5 text-red-500 font-bold text-sm" id="game-lives">
                        <i class="fa-solid fa-heart"></i>
                        <i class="fa-solid fa-heart"></i>
                        <i class="fa-solid fa-heart"></i>
                    </div>

                    <div class="bg-sakura-50 text-sakura-600 px-3 py-1 rounded-xl text-xs font-black border border-sakura-200">
                        連勝 Streak: <span id="game-combo" class="text-sm">0</span> 🔥
                    </div>

                    <div class="text-xs font-bold text-gray-500">
                        得分: <span id="game-score" class="text-sakura-600 font-extrabold text-base">0</span>
                    </div>
                </div>

                <!-- Quiz Main Area -->
                <div id="quiz-container" class="space-y-6 text-center py-4">
                    <div class="space-y-1">
                        <span id="quiz-category" class="bg-matcha-100 text-matcha-600 text-[10px] font-bold px-2.5 py-0.5 rounded-full">階段 1 · 打招呼</span>
                        <h3 id="quiz-question-jp" class="text-3xl sm:text-4xl font-black text-gray-800 tracking-wider">こんにちは</h3>
                        <p id="quiz-question-kana" class="text-xs text-sakura-500 font-bold">kon-ni-chi-wa</p>
                    </div>

                    <p id="quiz-prompt" class="text-sm text-gray-600 font-medium">這句話在中文裡是什麼意思呢？</p>

                    <!-- Answer Options Grid -->
                    <div id="quiz-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                        <!-- Injected via JavaScript -->
                    </div>
                </div>

                <!-- Game Result Modal / Overlay -->
                <div id="game-over-box" class="hidden text-center py-8 space-y-4">
                    <div class="text-5xl">🎉</div>
                    <h3 class="text-2xl font-black text-gray-800">闖關測試完成！</h3>
                    <p class="text-xs text-gray-600">你獲得了 <span id="final-score" class="text-sakura-600 font-extrabold">100</span> 分與 <span id="final-xp" class="text-matcha-600 font-extrabold">+30 XP</span>！</p>
                    <button onclick="startQuizGame()" class="bg-sakura-500 hover:bg-sakura-600 text-white font-bold px-6 py-3 rounded-2xl text-xs shadow-md touch-bounce">
                        <i class="fa-solid fa-rotate-right"></i> 再挑戰一次
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= TAB 3: 多元主題學習庫 (MULTI-THEME CONTENT) ================= -->
        <section id="tab-themes" class="tab-content hidden space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <h2 class="text-xl font-extrabold text-gray-800 flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-sakura-500"></i> 多元情境與主題教學
                    </h2>
                    <p class="text-xs text-gray-500 mt-0.5">點擊任何主題探索單字、句型與真人語音示範</p>
                </div>

                <!-- Theme Category Scroll Filter -->
                <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
                    <button onclick="renderThemeContent('all')" class="theme-tab-btn bg-sakura-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap">全部</button>
                    <button onclick="renderThemeContent('food')" class="theme-tab-btn bg-gray-100 text-gray-600 px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap">🍱 美食點餐</button>
                    <button onclick="renderThemeContent('anime')" class="theme-tab-btn bg-gray-100 text-gray-600 px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap">⚔️ 動漫影視</button>
                    <button onclick="renderThemeContent('travel')" class="theme-tab-btn bg-gray-100 text-gray-600 px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap">⛩️ 旅遊交通</button>
                    <button onclick="renderThemeContent('news')" class="theme-tab-btn bg-gray-100 text-gray-600 px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap">📰 時事新聞</button>
                </div>
            </div>

            <div id="theme-cards-container" class="space-y-4">
                <!-- Javascript will inject theme content here -->
            </div>
        </section>

        <!-- ================= TAB 4: AI 語音教練 (AI SPEAKING COACH) ================= -->
        <section id="tab-speaking" class="tab-content hidden space-y-6">
            <div>
                <h2 class="text-xl font-extrabold text-gray-800 flex items-center gap-2">
                    <i class="fa-solid fa-comments text-sakura-500"></i> AI 語音互動教練
                </h2>
                <p class="text-xs text-gray-500 mt-0.5">選擇生活情境或自由開口說日文，AI 將協助矯正語法與發音！</p>
            </div>

            <div class="cute-card rounded-3xl p-4 sm:p-6 bg-white space-y-4">
                <!-- Chat Log View -->
                <div id="chat-messages" class="h-80 sm:h-96 overflow-y-auto space-y-3 pr-1 text-xs sm:text-sm">
                    <div class="flex gap-2.5">
                        <div class="w-8 h-8 rounded-2xl bg-sakura-200 text-sakura-600 flex items-center justify-center text-sm font-black flex-shrink-0">🍡</div>
                        <div class="bg-sakura-50 border border-sakura-200 rounded-2xl p-3 text-gray-800 max-w-[85%] space-y-1">
                            <p class="font-bold text-sakura-600">こんにちは！私（わたし）と一緒に日本語（にほんご）を話（はな）しましょう！</p>
                            <p class="text-gray-500 text-[11px]">（你好呀！跟我一起練習說日文吧！）</p>
                        </div>
                    </div>
                </div>

                <!-- Input Box Bar -->
                <div class="border-t border-sakura-100 pt-3 flex items-center gap-2">
                    <input type="text" id="chat-text-input" placeholder="輸入日文或中文對話..." class="flex-1 bg-sakura-50 border border-sakura-200 rounded-2xl px-3.5 py-2.5 text-xs sm:text-sm focus:outline-none focus:border-sakura-400">

                    <button id="record-btn" onclick="toggleVoiceRecording()" class="w-10 h-10 bg-sakura-500 hover:bg-sakura-600 text-white rounded-2xl flex items-center justify-center transition shadow-sm touch-bounce flex-shrink-0">
                        <i class="fa-solid fa-microphone text-sm"></i>
                    </button>

                    <button onclick="sendChatMessage()" class="w-10 h-10 bg-matcha-500 hover:bg-matcha-600 text-white rounded-2xl flex items-center justify-center transition shadow-sm touch-bounce flex-shrink-0">
                        <i class="fa-solid fa-paper-plane text-sm"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= TAB 5: 單字筆記 (DICTIONARY NOTEBOOK) ================= -->
        <section id="tab-notebook" class="tab-content hidden space-y-6">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-xl font-extrabold text-gray-800 flex items-center gap-2">
                        <i class="fa-solid fa-bookmark text-sakura-500"></i> 我的單字筆記庫
                    </h2>
                    <p class="text-xs text-gray-500 mt-0.5">點擊文章或例句中的單字即可自動收錄至此</p>
                </div>
                <button onclick="clearSavedWords()" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold px-3 py-1.5 rounded-xl transition">
                    清空筆記
                </button>
            </div>

            <div id="saved-words-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                <!-- Javascript will inject saved word cards here -->
            </div>
        </section>

    </main>

    <!-- Mobile Bottom Navigation Bar (Fixed for Mobile Screens) -->
    <div class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-sakura-200 py-2 px-3 flex justify-around items-center shadow-lg">
        <button onclick="switchTab('map')" id="m-nav-map" class="flex flex-col items-center gap-0.5 text-sakura-600">
            <i class="fa-solid fa-route text-lg"></i>
            <span class="text-[10px] font-bold">闖關</span>
        </button>
        <button onclick="switchTab('game')" id="m-nav-game" class="flex flex-col items-center gap-0.5 text-gray-400">
            <i class="fa-solid fa-gamepad text-lg"></i>
            <span class="text-[10px] font-bold">冒險遊戲</span>
        </button>
        <button onclick="switchTab('themes')" id="m-nav-themes" class="flex flex-col items-center gap-0.5 text-gray-400">
            <i class="fa-solid fa-layer-group text-lg"></i>
            <span class="text-[10px] font-bold">主題庫</span>
        </button>
        <button onclick="switchTab('speaking')" id="m-nav-speaking" class="flex flex-col items-center gap-0.5 text-gray-400">
            <i class="fa-solid fa-comments text-lg"></i>
            <span class="text-[10px] font-bold">AI 語音</span>
        </button>
        <button onclick="switchTab('notebook')" id="m-nav-notebook" class="flex flex-col items-center gap-0.5 text-gray-400">
            <i class="fa-solid fa-bookmark text-lg"></i>
            <span class="text-[10px] font-bold">單字筆記</span>
        </button>
    </div>

    <!-- POPUP DICTIONARY MODAL -->
    <div id="dict-modal" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="cute-card bg-white rounded-3xl max-w-sm w-full p-5 space-y-4 relative shadow-2xl animate-bounce-in">
            <!-- Close Button -->
            <button onclick="closeDictModal()" class="absolute top-4 right-4 w-7 h-7 bg-gray-100 text-gray-500 rounded-full flex items-center justify-center text-xs">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <!-- Word Info Header -->
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 bg-sakura-100 text-sakura-600 rounded-2xl flex items-center justify-center text-xl font-black">
                    🌸
                </div>
                <div>
                    <span id="dict-pos" class="bg-sakura-100 text-sakura-600 text-[10px] font-bold px-2 py-0.5 rounded">單字</span>
                    <h3 id="dict-word" class="text-2xl font-black text-gray-800">櫻</h3>
                </div>
            </div>

            <!-- Phonetics Box with Accurate Romaji -->
            <div class="bg-sakura-50 rounded-2xl p-3 flex items-center justify-between border border-sakura-100">
                <div class="space-y-0.5">
                    <div class="text-xs text-gray-500">日文假名：<span id="dict-kana" class="font-bold text-sakura-600 text-sm">さくら</span></div>
                    <div class="text-xs text-gray-500">精準羅馬音：<span id="dict-romaji" class="font-bold text-gray-800 text-xs tracking-wide">sakura</span></div>
                </div>
                <button id="dict-audio-btn" onclick="playCurrentDictAudio(event)" class="w-10 h-10 bg-sakura-500 hover:bg-sakura-600 text-white rounded-xl flex items-center justify-center transition shadow-sm touch-bounce">
                    <i class="fa-solid fa-volume-high text-sm"></i>
                </button>
            </div>

            <!-- Chinese Meaning -->
            <div>
                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">【中文意思】</span>
                <p id="dict-meaning" class="text-base font-bold text-gray-800">櫻花</p>
            </div>

            <!-- Example Sentence -->
            <div class="bg-gray-50 p-3 rounded-2xl border border-gray-100 text-xs space-y-1">
                <span class="font-bold text-sakura-600">💡 記憶聯想 / 例句：</span>
                <p id="dict-example-jp" class="font-bold text-gray-800">日本の桜はとても綺麗です。</p>
                <p id="dict-example-zh" class="text-gray-500">（日本的櫻花非常美麗。）</p>
            </div>

            <!-- Save Word Button -->
            <button onclick="saveCurrentWord()" class="w-full bg-matcha-500 hover:bg-matcha-600 text-white font-bold py-2.5 rounded-2xl text-xs flex items-center justify-center gap-2 transition shadow-md touch-bounce">
                <i class="fa-solid fa-bookmark"></i> 收藏至「單字筆記」
            </button>
        </div>
    </div>

    <!-- API Key Settings Modal -->
    <div id="apikey-modal" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="cute-card bg-white rounded-3xl max-w-xs w-full p-5 space-y-4">
            <h3 class="font-bold text-gray-800 text-sm flex items-center gap-2">
                <i class="fa-solid fa-gear text-sakura-500"></i> API 設定
            </h3>
            <p class="text-xs text-gray-500 leading-relaxed">輸入您的 Gemini API Key 即可啟用 AI 智慧即時對話與糾錯功能：</p>
